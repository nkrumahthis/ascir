DB_URL=postgres://user:password@host:5432/ascir
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ascir
S3_ENDPOINT=https://hel1.your-objectstorage.com

# Temporary ascir.org ingest API. Off unless exactly "true".
INGEST_ENABLED=false
INGEST_TOKEN=

# ETL push (npm run etl:push). These two go in .env.etl, not .env.local;
# .env.etl is git-ignored. Nkrumah gives out the URL and token per target.
# INGEST_URL=https://your-preview.vercel.app
# INGEST_TOKEN=
